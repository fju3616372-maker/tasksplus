<div class="Section1">

  <!-- ==================== PAGE 1 ==================== -->
  <table class="header-bar"><tr><td>TASKS+ &bull; PROJECT DIARY BOOKLET</td><td align="right">01 / COVER &amp; USES</td></tr></table>

  <table style="width:100%; border-collapse:collapse; margin-bottom:10pt;">
    <tr>
      <td style="background:#177E5B; height:5pt; width:20%;"></td>
      <td style="background:#7CB342; height:5pt; width:20%;"></td>
      <td style="background:#B87414; height:5pt; width:20%;"></td>
